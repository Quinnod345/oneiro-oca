# Python compilation cache
__pycache__/
*.py[co]

# Timestamped backups created by regrade_uncertain.py / pairwise_grade.py
# (we keep recent ones in data/backups/ but never the bare data/*.bak.json)
data/*.bak.json
data/manifest.*.bak.json
data/comparisons.*.bak.json

# Runtime state — written by parallel self_train workers, transient
data/*.lock

# Virtual envs / IDE
.venv/
.idea/
.vscode/

# Per-seed multi-seed checkpoints — only the canonical
# design-head-v7.safetensors is committed
weights/design-head-v7-seed*.safetensors
weights/train-v7-seed*-meta.json
weights/design-head-v7-rpw*.safetensors
weights/train-v7-rpw*-meta.json
weights/train-v7-*-multiseed-summary.json

# Smoketest outputs
weights/design-head-v7-smoketest*.safetensors
weights/train-v7-smoketest*-meta.json

# DINOv2 patch-token features cache (343 MB; regenerable via
# `python mlx/extract_dinov2.py --include-patches`)
data/dinov2_patch_features.npz

# mlx-vlm distillation artifacts (large; regenerable via train pipeline)
data/distill_mlx/
weights/distill-mlx-*/
weights/distill-mlx-*.safetensors
weights/0*_adapters.safetensors
