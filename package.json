{
  "name": "oneiro-oca",
  "version": "0.3.0",
  "description": "Oneiro Cognitive Architecture — embodied machine cognition on consumer hardware",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./emotion": "./emotion/engine.js",
    "./hypothesis": "./hypothesis/engine.js",
    "./memory/episodic": "./memory/episodic.js",
    "./memory/semantic": "./memory/semantic.js",
    "./memory/procedural": "./memory/procedural.js",
    "./memory/prospective": "./memory/prospective.js",
    "./memory/consolidation": "./memory/consolidation.js",
    "./memory/entity-graph": "./memory/entity-graph.js",
    "./metacognition": "./metacognition/engine.js",
    "./deliberation": "./deliberation/engine.js",
    "./reasoning": "./reasoning/controller.js",
    "./simulation": "./simulation/engine.js",
    "./causal": "./causal/engine.js",
    "./creative": "./creative/engine.js",
    "./sensory": "./sensory/perception.js",
    "./executive": "./executive/engine.js",
    "./event-bus": "./event-bus.js",
    "./llm": "./llm.js",
    "./api": "./api-routes.js",
    "./loop": "./cognitive-loop.js"
  },
  "bin": {
    "oneiro-oca": "./cognitive-loop.js"
  },
  "scripts": {
    "bootstrap": "bash bootstrap.sh",
    "test": "node --env-file=../.env test.js",
    "migrate": "for f in migrations/*.sql; do echo \"Running $f\"; psql -v ON_ERROR_STOP=1 \"${DATABASE_URL:-postgres://localhost/oneiro}\" -f \"$f\"; done",
    "start": "node --env-file=../.env cognitive-loop.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "dotenv": "^17.0.0",
    "openai": "^4.0.0",
    "pg": "^8.11.0",
    "puppeteer": "^24.40.0"
  },
  "keywords": [
    "cognitive-architecture",
    "embodied-cognition",
    "ai-agent",
    "machine-cognition",
    "hypothesis-engine",
    "emotion-engine",
    "metacognition",
    "macos",
    "openclaw",
    "predictive-processing"
  ],
  "author": "Quinn O'Donnell & Oneiro",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quinnod345/oneiro-oca.git"
  },
  "homepage": "https://github.com/Quinnod345/oneiro-oca#readme",
  "bugs": {
    "url": "https://github.com/Quinnod345/oneiro-oca/issues"
  }
}
